# Examples work immediately without configuration.
PSS_ENABLE_LIVE=false
PSS_PROVIDER=openrouter
PSS_MODEL=your-selected-tool-capable-model
OPENROUTER_API_KEY=

# Optional authenticated local llama.cpp server; see docs/SETUP.md.
# PSS_PROVIDER=llamacpp
# PSS_MODEL=your-server-model-alias
# PSS_LOCAL_URL=http://127.0.0.1:4317
# PSS_LOCAL_KEY_FILE=/absolute/path/to/server-key.txt
